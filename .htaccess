# 다이얼(big5) — sonbm.com/big5/ 하위 폴더 전용
# 루트 WordPress 의 재작성 규칙(index.php 로 모두 보냄)이 이 폴더 요청을 가로채지 않게,
# 이 폴더에서 재작성 엔진을 새로 켠다(상위 규칙은 상속되지 않는다).
<IfModule mod_rewrite.c>
RewriteEngine On
</IfModule>
DirectoryIndex index.php
Options -Indexes
# 문서·점검 파일 직접 열람 차단
<FilesMatch "\.(md|json|sqlite|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
# 보안 응답 헤더 (mod_headers 가 있을 때만)
#  - 타인 평가 링크의 토큰이 다른 사이트(글꼴 CDN 등)의 Referer 로 새지 않게 same-origin
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>
